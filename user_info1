class UserInfo:
    def __init__(self, height, weight, gender, age, nationality, body_fat=None, goal_weight=None, goal_days=None):
        self.height = height
        self.weight = weight
        self.gender = gender
        self.age = age
        self.nationality = nationality  # 추천식단과 운동을 위해 국적도 사용자 입력 정보에 추가한 버전
        self.body_fat = body_fat
        self.goal_weight = goal_weight
        self.goal_days = goal_days
